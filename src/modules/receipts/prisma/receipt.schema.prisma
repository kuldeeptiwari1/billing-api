model receipt {
  receiptNo      String   @unique
  receiptDate    DateTime
  studentName    String
  mobileNo       String   @unique
  course         String
  totalAmount    String
  paidAmount     String
  dueAmount      String
  paymentMode    String
  paymentDetails String
  dueDate        DateTime
  contactPerson  String
  notes          String
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("receipts")
}
