model student {
  name            String
  email           String   @unique
  phone           String   @unique
  gender          String
  dateOfBirth     DateTime
  state           String
  city            String
  degreee          String
  courseName      String
  cllegeName      String
  passingYear     String
  modeOfClass     String
  department      String
  totalFees       String
  paidAmount      String
  remainingFees   String
  feesDueDate     DateTime
  preferredBranch String
  paymentMode     String
  documentType    String
  documentNo      String
  profession      String
  preferredBatch  String
  counsellorName  String
 
  @@map("students")
}