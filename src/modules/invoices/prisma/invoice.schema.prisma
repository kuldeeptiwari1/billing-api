model invoice {
  invoiceNo     String   @unique
  studentName   String
  mobileNo      String   @unique
  contactPerson String
  issueDate     DateTime
  dueDate       DateTime
  status        String
  totalAmount   String
  paidAmount    String
  dueAmount     String
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("invoices")
}
