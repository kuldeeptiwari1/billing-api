model expense {
    date                DateTime
    cashExpense         String
    bankExpense         String
    paytmExpense        String
    cashAmount          String
    bankAmount          String
    paytmAmount         String
    networking          String
    development         String
    softskill           String
    banking             String
    placementNetworking String
    cad                 String
    total               String
    totalExpense        String
    totalCashback       String
    grandTotal          String
    isDeleted           Boolean  @default(false)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@map("expenses")
}
