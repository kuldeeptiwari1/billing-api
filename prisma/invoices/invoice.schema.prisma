datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

model invoice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo     String   @unique
  studentName   String
  status        String
  issueDate     DateTime
  course        String
  taxPercentage String   @default("NA")
  discount      String   @default("NA")
  totalPrice    String
  baseAmount    String
  totalDiscount String
  subtotal      String
  totalTaxes    String
  finalAmount   String
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("invoices")
}
