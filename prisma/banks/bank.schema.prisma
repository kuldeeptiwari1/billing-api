datasource db {
  provider = "mongodb"
  url      = "mongodb://localhost:27017/billing"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

model bank {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  slug   String @unique
  branch String

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banks")
}
