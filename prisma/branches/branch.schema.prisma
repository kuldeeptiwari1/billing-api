datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

model branch {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  address     String
  closingDate DateTime
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("branches")
}
