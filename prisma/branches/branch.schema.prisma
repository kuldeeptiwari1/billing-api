datasource db {
  provider = "mongodb"
  url      = "mongodb://localhost:27017/billing"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

model branch {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  slug       String @unique
  code       String @unique
  address    String
  email      String
  contact    String
  closingDay Float  @default(5)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}
